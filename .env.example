# Copia este archivo a .env y cambia los valores. .env nunca se sube al repo.

# Contenedor PostgreSQL (compose.yaml)
POSTGRES_DB=portafolio
POSTGRES_USER=cambia-este-usuario
POSTGRES_PASSWORD=cambia-esta-contrasena

# Aplicación: deben coincidir con los valores de arriba
DB_URL=jdbc:postgresql://localhost:5432/portafolio
DB_USER=cambia-este-usuario
DB_PASSWORD=cambia-esta-contrasena
